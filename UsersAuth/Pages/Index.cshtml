@page
@model IndexModel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity

@{
    ViewData["Title"] = "Authentication Module - Portfolio";
}

<div class="text-center mt-5">

    @if (User.Identity.IsAuthenticated)
    {
        <h1 class="display-4">Test Panel</h1>
        <p class="lead">Successful connection for user: <strong>@User.Identity.Name</strong></p>

        @if (User.IsInRole("Admin"))
        {
            <div class="card bg-warning bg-opacity-10 mt-4 p-4 shadow-sm mx-auto" style="max-width: 600px; border-left: 5px solid #ffc107;">
                <h4>Admin Functionality Demo</h4>
                <p>You are logged in as <strong>Administrator</strong> and can access identity management.</p>
                <a asp-page="/Admin/Roles" class="btn btn-warning btn-lg mt-3">
                    Go to Role Management (Demo)
                </a>
            </div>
        }
        else
        {
            <div class="alert alert-info mt-4 mx-auto" style="max-width: 600px;">
                Standard user session started successfully. To test identity management, log in with an account with the 'Admin' role.
            </div>
            <div class="nav-item">
                <form method="post" asp-area="Identity" asp-page="/Account/Logout" class="form-inline">
                    <input type="hidden" name="returnUrl" value="/Account/Logout" />
                    <button type="submit" class="btn btn-secondary mt-3">
                        Log Out
                    </button>
                </form>
            </div>
        }
    }
    else
    {
        <h1 class="display-3">Authentication and Authorization Module</h1>
        <p class="lead text-muted">
            This project demonstrates the implementation of security and identity management using Identity Framework.
        </p>

        <hr class="my-4" />

        <div class="row justify-content-center">
            <div class="col-md-8">
                <p class="mb-4">
                    <strong>Technologies:</strong> ASP.NET Core Razor Pages, C#, .NET Identity Framework, Entity Framework Core, SweetAlert2, Bootstrap.
                </p>

                <h4 class="mt-4">Key Features Implemented:</h4>
                <ul class="list-unstyled text-start mx-auto" style="width: fit-content;">
                    <li><i class="fas fa-check-circle me-2 text-success"></i> <strong>Registration and Login</strong> with email lookup.</li>
                    <li><i class="fas fa-check-circle me-2 text-success"></i> Implementation of <strong>Roles and Policies</strong> with <strong>AdminPolicy</strong> authorization.</li>
                    <li><i class="fas fa-check-circle me-2 text-success"></i> <strong>CRUD User Management</strong> and dynamic role assignment (Admin only).</li>
                    <li><i class="fas fa-check-circle me-2 text-success"></i> User-friendly notification system using <strong>SweetAlert2.</strong></li>
                </ul>
            </div>
        </div>

        <div class="mt-5">
            <a href="https://github.com/ignabarolo/UsersAuth" target="_blank" class="btn btn-dark btn-lg me-3">
                View Source Code (GitHub) <i class="fab fa-github ms-2"></i>
            </a>
            <a asp-page="/Account/Login" class="btn btn-outline-primary btn-lg">
                Try the System (Log in)
            </a>
        </div>
    }
</div>

@section Scripts {
        <<script src="https://kit.fontawesome.com/84b91a9756.js" crossorigin="anonymous"></script>
}